{
  "$comment": "Secret and personal-data patterns for the step-01 scan (compliance-inventory/scripts/sensitive_scan.py) and for the evidence checks of `compliance_report.py validate`/`aggregate`/`render`. Data, not code: edit here, then run the unit tests. Every regex is a Python regex. A rule's `value` group (or the whole match when it has none) is what is redacted; matched values are never stored. `fileGlobs` limits a rule to matching file names (same glob rules as subject-file-map.json); `excerpt: false` keeps a rule out of the evidence checks (it only finds candidates). Placeholders and the allowlist suppress a match; in files matching `exampleGlobs` only high-confidence formats count. Confidence: high = an unambiguous credential format; medium = a secret-named key with a literal value; low = weak signal.",
  "maxBytesPerFile": 262144,
  "maxLineLength": 4000,
  "maxCandidates": 50,
  "skipGlobs": [
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/*.lock",
    "**/packages.lock.json",
    "**/go.sum",
    "**/gradle.lockfile",
    "**/*.min.*",
    "**/*.map",
    "**/*.svg",
    "**/*.ipynb_checkpoints/**"
  ],
  "exampleGlobs": [
    ".env.example",
    ".env.sample",
    ".env.template",
    ".env.dist",
    "*.example",
    "*.sample",
    "*.template",
    "*.dist",
    "*.example.*",
    "*.sample.*",
    "*.template.*"
  ],
  "secrets": {
    "formats": [
      {
        "rule": "aws-access-key-id",
        "kind": "api-key",
        "confidence": "high",
        "regex": "(?<![A-Z0-9])(?P<value>(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16})(?![A-Z0-9])"
      },
      {
        "rule": "github-token",
        "kind": "token",
        "confidence": "high",
        "regex": "(?<![A-Za-z0-9_])(?P<value>gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{22,255})"
      },
      {
        "rule": "slack-token",
        "kind": "token",
        "confidence": "high",
        "regex": "(?<![A-Za-z0-9])(?P<value>xox[bpas]-[A-Za-z0-9-]{10,})"
      },
      {
        "rule": "stripe-live-key",
        "kind": "api-key",
        "confidence": "high",
        "regex": "(?<![A-Za-z0-9])(?P<value>(?:sk|rk)_live_[A-Za-z0-9]{16,})"
      },
      {
        "rule": "google-api-key",
        "kind": "api-key",
        "confidence": "high",
        "regex": "(?<![A-Za-z0-9_-])(?P<value>AIza[0-9A-Za-z_-]{35})(?![0-9A-Za-z_-])"
      },
      {
        "rule": "azure-storage-key",
        "kind": "account-key",
        "confidence": "high",
        "regex": "(?i)\\b(?:AccountKey|SharedAccessKey)\\s*=\\s*(?P<value>[A-Za-z0-9+/]{20,}={0,2})"
      },
      {
        "rule": "private-key-block",
        "kind": "private-key",
        "confidence": "high",
        "valueRequiredInExcerpt": true,
        "regex": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY(?: BLOCK)?-----(?:\\s|\\\\n)*(?P<value>[A-Za-z0-9+/=]{16,})?"
      },
      {
        "rule": "jwt",
        "kind": "token",
        "confidence": "high",
        "regex": "(?<![A-Za-z0-9_-])(?P<value>eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
      }
    ],
    "assignments": [
      {
        "rule": "secret-assignment",
        "kind": "secret",
        "confidence": "medium",
        "regex": "(?i)(?P<key>[\\w.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|connection[_-]?string|connstr|auth[_-]?key|credentials?)[\\w.-]*)[\\\"']?\\s*(?::=|=>|:|=)\\s*(?P<q>[\\\"'])(?P<value>[^\\\"'\\s]{4,})(?P=q)"
      },
      {
        "rule": "config-secret-assignment",
        "kind": "secret",
        "confidence": "medium",
        "fileGlobs": [
          ".env",
          ".env.*",
          "*.env",
          "*.{yml,yaml,properties,ini,cfg,conf,toml,tfvars}",
          "Dockerfile",
          "Dockerfile.*",
          "*.Dockerfile",
          ".npmrc",
          ".pypirc",
          "pip.conf"
        ],
        "regex": "(?im)^\\s*(?:export\\s+|ENV\\s+|ARG\\s+|-\\s+)?(?P<key>[\\w.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|connection[_-]?string|connstr|auth[_-]?key|credentials?)[\\w.-]*)\\s*[=:]\\s*(?P<value>[^\\s\\\"'#]{4,})"
      },
      {
        "rule": "connection-string-password",
        "kind": "password",
        "confidence": "medium",
        "regex": "(?i)(?:^|[;\\\"'\\s])(?P<key>password|pwd)\\s*=\\s*(?P<value>[^;\\\"'\\s<>{}$%]{3,})(?=;|\\\"|'|\\s|$)"
      },
      {
        "rule": "url-credentials",
        "kind": "password",
        "confidence": "medium",
        "regex": "(?i)\\b[a-z][a-z0-9+.-]*://[^\\s:/@\\\"']+:(?P<value>[^\\s@/\\\"'$<{%]{3,})@[^\\s/\\\"']+"
      },
      {
        "rule": "env-secret-assignment",
        "kind": "secret",
        "confidence": "medium",
        "excerpt": false,
        "regex": "(?m)^\\s*(?:export\\s+)?(?P<key>[A-Z0-9_]*(?:PASSWORD|PASSWD|PWD|SECRET|TOKEN|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|CLIENT_?SECRET|CONNECTION_?STRING|AUTH_?KEY|CREDENTIALS?)[A-Z0-9_]*)\\s*=\\s*(?P<value>[^\\s\\\"'#]{4,})"
      }
    ],
    "placeholders": {
      "valueRegex": "(?i)^(?:\\$\\{.*\\}|\\$\\(.*\\)|\\$[A-Za-z_]\\w*|%[A-Za-z_]\\w*%|\\{\\{.*\\}\\}|<.*>|#\\{.*\\}|@[\\w.]+@|\\[.*\\]|\\*+|x{3,}|\\.{3,}|true|false|null|none|nil|undefined|string|str|int|number|bool|boolean|bytes|any|object|optional\\[.*|secretstr|required|empty|redacted|masked|hidden|n/?a|tbd|todo)$",
      "containsRegex": "(?i)changeme|change[_-]me|change[_-]?this|example|sample|placeholder|dummy|your[_-]|replace[_-]?me|<redacted|insert[_-]|fill[_-]?in|os\\.environ|getenv|process\\.env|environ\\[|configuration\\[|config\\[|settings\\.|secretkeyref|valuefrom|keyvault|vault:"
    },
    "allowlist": [
      "AKIAIOSFODNN7EXAMPLE",
      "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
      "Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==",
      "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    ],
    "files": [
      {
        "rule": "env-file",
        "kind": "env",
        "confidence": "medium",
        "globs": [
          ".env",
          ".env.*",
          "*.env"
        ],
        "exclude": [
          ".env.example",
          ".env.sample",
          ".env.template",
          ".env.dist",
          "*.example",
          "*.sample",
          "*.template",
          "*.dist"
        ],
        "lineRegex": "^\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_.]*\\s*=\\s*(?P<value>[^\\s#].*?)\\s*$"
      },
      {
        "rule": "private-key-file",
        "kind": "private-key",
        "confidence": "high",
        "globs": [
          "*.pem",
          "*.key",
          "id_rsa",
          "id_dsa",
          "id_ecdsa",
          "id_ed25519",
          "*.ppk"
        ],
        "exclude": [
          "*.pub"
        ],
        "lineRegex": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY|PuTTY-User-Key-File"
      },
      {
        "rule": "keystore-file",
        "kind": "keystore",
        "confidence": "medium",
        "globs": [
          "*.pfx",
          "*.p12",
          "*.jks",
          "*.keystore",
          "*.snk"
        ],
        "binaryOk": true
      },
      {
        "rule": "cloud-credentials-file",
        "kind": "credentials",
        "confidence": "medium",
        "globs": [
          "credentials.json",
          "*service-account*.json",
          "*serviceaccount*.json",
          "client_secret*.json"
        ],
        "lineRegex": "\\\"(?:private_key|client_secret|private_key_id|refresh_token)\\\"\\s*:\\s*\\\"[^\\\"]{8,}"
      },
      {
        "rule": "package-manager-auth",
        "kind": "token",
        "confidence": "medium",
        "globs": [
          ".npmrc",
          ".yarnrc.yml",
          ".pypirc",
          "settings.xml",
          "pip.conf",
          "pip.ini",
          "nuget.config",
          "NuGet.config",
          "NuGet.Config",
          ".netrc",
          "_netrc"
        ],
        "lineRegex": "(?i)(?:_authToken|_auth|npmAuthToken|_password)\\s*[=:]\\s*[^\\s$\\\"']|^\\s*password\\s*[=:]\\s*[^\\s$%]|<password>\\s*[^<$\\s]|ClearTextPassword\\\"\\s+value=\\\"[^\\\"$%]|^\\s*machine\\s+\\S+\\s+login\\s+\\S+\\s+password\\s+\\S"
      }
    ]
  },
  "pii": {
    "$comment": "Phase-4 personal-data candidates: scanned only in test, fixture, seed and sample files (see scopeGlobs and the inventory's test files).",
    "scopeGlobs": [
      "**/fixtures/**",
      "**/fixture/**",
      "**/testdata/**",
      "**/test-data/**",
      "**/seed/**",
      "**/seeds/**",
      "**/seeders/**",
      "**/*{seed,Seed,SEED}*",
      "**/samples/**",
      "**/sample/**",
      "**/*{sample,Sample}*",
      "**/sample-data/**",
      "**/mock-data/**",
      "**/mocks/**",
      "**/*{mock,Mock}*{data,Data}*"
    ],
    "rules": [
      {
        "rule": "payment-card-number",
        "kind": "card-number",
        "confidence": "high",
        "check": "luhn",
        "regex": "(?<![\\d-])(?P<value>(?:4\\d{3}|5[1-5]\\d{2}|2[2-7]\\d{2}|3[47]\\d{2}|6(?:011|5\\d{2}))(?:[ -]?\\d{4}){2}[ -]?\\d{1,4}(?:[ -]?\\d{3})?)(?![\\d-])"
      },
      {
        "rule": "iban",
        "kind": "iban",
        "confidence": "high",
        "check": "iban",
        "regex": "(?<![A-Z0-9])(?P<value>[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,3})?)(?![A-Z0-9])"
      },
      {
        "rule": "us-ssn",
        "kind": "national-id",
        "confidence": "medium",
        "regex": "(?<![\\d-])(?P<value>(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4})(?![\\d-])"
      },
      {
        "rule": "uk-ni-number",
        "kind": "national-id",
        "confidence": "medium",
        "regex": "(?<![A-Za-z0-9])(?P<value>(?!BG|GB|NK|KN|TN|NT|ZZ)[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z] ?\\d{2} ?\\d{2} ?\\d{2} ?[A-D])(?![A-Za-z0-9])"
      },
      {
        "rule": "email-address",
        "kind": "email",
        "confidence": "low",
        "excerpt": false,
        "check": "email",
        "regex": "(?<![\\w.+-])(?P<value>[A-Za-z0-9._%+-]+@(?P<domain>[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}))(?![\\w-])"
      }
    ],
    "reservedEmailDomains": "(?i)(?:^|\\.)(?:example\\.(?:com|org|net)|example|test|invalid|localhost|local|internal)$",
    "allowlist": [
      "4111111111111111",
      "4242424242424242",
      "4012888888881881",
      "4000056655665556",
      "4000000000000002",
      "4000000000009995",
      "4000000000000077",
      "5555555555554444",
      "5105105105105100",
      "5200828282828210",
      "2223003122003222",
      "378282246310005",
      "371449635398431",
      "6011111111111117",
      "6011000990139424",
      "QQ123456C",
      "GB82WEST12345698765432",
      "DE89370400440532013000",
      "078-05-1120",
      "123-45-6789"
    ]
  },
  "personalData": {
    "$comment": "Signals that set personalDataFound (step 01). review-data-protection is N/A when none is found.",
    "fieldGlobs": [
      "**/Models/**",
      "**/models/**",
      "**/models.py",
      "**/Entities/**",
      "**/entities/**",
      "**/*Entity.*",
      "**/Domain/**",
      "**/domain/**",
      "**/Dtos/**",
      "**/DTOs/**",
      "**/dto/**",
      "**/dtos/**",
      "**/*Dto.*",
      "**/*DTO.*",
      "**/schemas.py",
      "**/schemas/**",
      "**/serializers.py",
      "**/*Request.*",
      "**/*Response.*",
      "**/*Item.*",
      "**/model/**",
      "**/*Model.*",
      "**/types/**",
      "**/interfaces/**"
    ],
    "fieldMarkers": "@Entity\\b|@Table\\b|@Document\\b|DbSet<|models\\.Model|BaseModel\\b|SQLModel|mapped_column|Column\\(|@Column\\b|Schema\\(|@dataclass|\\brecord\\s+\\w+\\s*\\(|interface\\s+\\w+\\s*\\{|\\bclass\\s+\\w+",
    "fields": "(?i)(?<![A-Za-z])(?:e[_-]?mail(?:[_-]?address)?|phone(?:[_-]?number)?|mobile(?:[_-]?number)?|street(?:[_-]?address)?|home[_-]?address|postal[_-]?code|zip[_-]?code|date[_-]?of[_-]?birth|birth[_-]?date|dob|ssn|social[_-]?security(?:[_-]?number)?|national[_-]?id|tax[_-]?id|passport(?:[_-]?number)?|driver'?s?[_-]?licen[cs]e|iban|card[_-]?number|credit[_-]?card|first[_-]?name|last[_-]?name|full[_-]?name|surname)(?![A-Za-z])",
    "classification": "\\[(?:PersonalData|SensitiveData|ProtectedPersonalData|EUII|EUPI|PII)\\b|DataClassification|Microsoft\\.Extensions\\.Compliance|@PersonalData\\b|@Sensitive\\w*\\b|@Pii\\b|\\bPersonalDataAttribute\\b",
    "tableGlobs": [
      "**/Migrations/**",
      "**/migrations/**",
      "**/*.sql",
      "**/flyway/**",
      "**/liquibase/**",
      "**/prisma/schema.prisma",
      "**/alembic/**"
    ],
    "tables": "(?i)create\\s+table\\s+(?:if\\s+not\\s+exists\\s+)?[\\\"`\\[]?(?:\\w+[\\\"`\\]]?\\.[\\\"`\\[]?)?(?:users?|customers?|accounts?|persons?|people|patients?|employees?|members?|contacts?|clients?|profiles?)\\b|CreateTable\\(\\s*name:\\s*\\\"(?:Users?|Customers?|Accounts?|Persons?|People|Patients?|Employees?|Members?|Contacts?|Clients?|Profiles?)\\\"|^model\\s+(?:User|Customer|Account|Person|Patient|Employee|Member|Contact|Client|Profile)\\s*\\{",
    "maxSignals": 10
  }
}
